rules_version = '2';

// ============================================================================
// BANK NUSANTARA DIGITAL — ENTERPRISE ZERO-TRUST FIRESTORE SECURITY RULES
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET: DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // GLOBAL HARDENED PRIMITIVES
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'fahmiammarulazka@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Anti-Spam Rate Limiting Server-Side: minimal jeda 500ms dari updatedAt sebelumnya
    function passesRateLimit() {
      return !('updatedAt' in existing())
        || !(existing().updatedAt is timestamp)
        || request.time >= existing().updatedAt + duration.value(500, 'ms');
    }

    // Kunci Immutability untuk ownerUid dan createdAt
    function preservesImmutableCore(userId) {
      return incoming().ownerUid == userId
        && incoming().ownerUid == existing().ownerUid
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (!('createdAtMs' in existing()) || incoming().createdAtMs == existing().createdAtMs);
    }

    // ------------------------------------------------------------------------
    // VALIDATION BLUEPRINTS (STANDALONE HELPERS)
    // ------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid'])
        && data.keys().hasOnly([
          'uid', 'ownerUid', 'email', 'emailKey', 'displayName', 'photoURL', 'photoUrl', 'role',
          'status', 'banReason', 'bannedAt', 'banExpiresAt', 'banDurationLabel',
          'appealStatus', 'appealNote', 'appealCategory', 'appealCount',
          'appealAdminNote', 'appealRequestedAt', 'banCustomConfig',
          'lastAccountId', 'currentAccountId', 'hasCompletedOnboarding',
          'isAnonymousVault', 'authMode', 'emailVerified', 'failedPinAttempts',
          'linkedFromAnonymousAt', 'lastDeviceId', 'syncVersion',
          'savedAccounts', 'notificationCategoryPermissions',
          'createdAt', 'updatedAt', 'updatedAtMs', 'updatedAtServer'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() <= 128))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && (!('role' in data) || (data.role is string && data.role == 'customer'))
        && (!('status' in data) || (data.status is string && data.status in ['active', 'banned']))
        && (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 1000))
        && (!('lastDeviceId' in data) || (data.lastDeviceId is string && data.lastDeviceId.size() <= 128))
        && (!('syncVersion' in data) || (data.syncVersion is int && data.syncVersion >= 1))
        && (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding is bool)
        && (!('isAnonymousVault' in data) || data.isAnonymousVault is bool);
    }

    function isValidVaultState(data, userId) {
      return data.keys().hasAll(['ownerUid', 'syncVersion', 'lastDeviceId', 'payload'])
        && data.keys().hasOnly([
          'ownerUid', 'createdAt', 'updatedAt', 'updatedAtServer',
          'createdAtMs', 'updatedAtMs', 'createdAtIso', 'updatedAtIso',
          'syncVersion', 'lastDeviceId', 'payload'
        ])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() <= 128
        && data.syncVersion is int && data.syncVersion >= 1 && data.syncVersion <= 10000000
        && data.lastDeviceId is string && data.lastDeviceId.size() >= 4 && data.lastDeviceId.size() <= 128
        && data.payload is map
        && (!('createdAtIso' in data) || (data.createdAtIso is string && data.createdAtIso.size() <= 64))
        && (!('updatedAtIso' in data) || (data.updatedAtIso is string && data.updatedAtIso.size() <= 64))
        && (!('createdAtMs' in data) || data.createdAtMs is number)
        && (!('updatedAtMs' in data) || data.updatedAtMs is number);
    }

    function isValidLegacyVaultSubDoc(data, userId) {
      return data.keys().hasAll(['ownerId'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId.size() <= 128;
    }

    function isValidSnapshot(data, userId) {
      return data.keys().hasAll(['id', 'ownerUid', 'label', 'triggerReason', 'sha256', 'payload'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'label', 'triggerReason', 'createdAtMs', 'createdAtIso',
          'deviceId', 'sha256', 'accountCount', 'transactionCount', 'pocketCount',
          'totalBalance', 'totalGoldGrams', 'payload', 'updatedAtServer'
        ])
        && data.id is string && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() <= 128
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 160
        && data.triggerReason is string
        && data.triggerReason in ['manual', 'pre_restore', 'pre_import', 'pre_reset', 'pre_merge']
        && data.sha256 is string && data.sha256.size() == 64 && data.sha256.matches('^[a-f0-9]{64}$')
        && data.payload is map
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
        && (!('accountCount' in data) || (data.accountCount is int && data.accountCount >= 0 && data.accountCount <= 500))
        && (!('transactionCount' in data) || (data.transactionCount is int && data.transactionCount >= 0 && data.transactionCount <= 5000));
    }

    function isValidSecurityLog(data, userId) {
      return data.keys().hasAll(['id', 'ownerUid', 'eventType', 'summary', 'status', 'deviceId', 'createdAtMs'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'eventType', 'summary', 'status', 'deviceId',
          'deviceLabel', 'platform', 'userAgent', 'createdAtMs', 'createdAtIso',
          'details', 'updatedAtServer'
        ])
        && data.id is string && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() <= 128
        && data.eventType is string && data.eventType.size() >= 2 && data.eventType.size() <= 64
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.status is string && data.status in ['success', 'warning', 'blocked']
        && data.deviceId is string && data.deviceId.size() >= 4 && data.deviceId.size() <= 128
        && data.createdAtMs is number
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 120))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 80))
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 320))
        && (!('details' in data) || data.details is map);
    }

    function isValidDeviceSession(data, userId) {
      return data.keys().hasAll(['id', 'ownerUid', 'deviceId', 'authMethod', 'revoked'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'deviceId', 'deviceLabel', 'platform', 'userAgent',
          'authMethod', 'firstSeenIso', 'lastActiveIso', 'lastActiveMs',
          'revoked', 'revokedAtIso', 'updatedAtServer'
        ])
        && data.id is string && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid.size() <= 128
        && data.deviceId is string && data.deviceId.size() >= 4 && data.deviceId.size() <= 128
        && data.authMethod is string && data.authMethod in ['google', 'anonymous']
        && data.revoked is bool
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 120))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 80))
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 320));
    }

    function isValidLetterSealRegistry(data) {
      return data.keys().hasAll(['config', 'updatedAtMs'])
        && data.keys().hasOnly([
          'config', 'updatedAtMs', 'updatedAt', 'writerSessionId', 'updatedByUid', 'updatedByEmail'
        ])
        && data.updatedAtMs is number
        && data.config is map
        && data.config.keys().hasAll(['signatureMode', 'signatureName'])
        && data.config.keys().hasOnly([
          'signatureMode', 'signatureDrawingDataUrl', 'signatureTemplateId',
          'signatureName', 'signatureColor', 'stampTemplateId',
          'stampPrimaryName', 'stampSecondaryName', 'stampColor'
        ])
        && data.config.signatureMode is string
        && data.config.signatureMode in ['draw', 'template']
        && data.config.signatureName is string
        && data.config.signatureName.size() <= 160
        && (!('signatureDrawingDataUrl' in data.config) || (data.config.signatureDrawingDataUrl is string && data.config.signatureDrawingDataUrl.size() <= 66000))
        && (!('signatureTemplateId' in data.config) || (data.config.signatureTemplateId is string && data.config.signatureTemplateId.size() <= 64))
        && (!('signatureColor' in data.config) || (data.config.signatureColor is string && data.config.signatureColor.size() <= 32))
        && (!('stampTemplateId' in data.config) || (data.config.stampTemplateId is string && data.config.stampTemplateId.size() <= 64))
        && (!('stampPrimaryName' in data.config) || (data.config.stampPrimaryName is string && data.config.stampPrimaryName.size() <= 160))
        && (!('stampSecondaryName' in data.config) || (data.config.stampSecondaryName is string && data.config.stampSecondaryName.size() <= 160))
        && (!('stampColor' in data.config) || (data.config.stampColor is string && data.config.stampColor.size() <= 32))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('writerSessionId' in data) || (data.writerSessionId is string && data.writerSessionId.size() <= 128))
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid == request.auth.uid && data.updatedByUid.size() <= 128))
        && (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 254));
    }

    function isValidGiftEventsRegistry(data) {
      return data.keys().hasAll(['giftEventsInitialized', 'giftEventsUpdatedAtMs', 'updatedAtMs'])
        && data.keys().hasOnly([
          'giftEvents', 'deletedGiftEventIds', 'giftEventsInitialized',
          'giftEventsUpdatedAtMs', 'updatedAtMs', 'updatedAt',
          'writerSessionId', 'updatedByUid', 'updatedByEmail'
        ])
        && data.giftEventsInitialized is bool
        && data.giftEventsUpdatedAtMs is number
        && data.updatedAtMs is number
        && (!('giftEvents' in data) || (data.giftEvents is list && data.giftEvents.size() <= 150 && (data.giftEvents.size() == 0 || data.giftEvents[0] is map)))
        && (!('deletedGiftEventIds' in data) || (data.deletedGiftEventIds is list && data.deletedGiftEventIds.size() <= 500 && (data.deletedGiftEventIds.size() == 0 || data.deletedGiftEventIds[0] is string)))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('writerSessionId' in data) || (data.writerSessionId is string && data.writerSessionId.size() <= 128))
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid == request.auth.uid && data.updatedByUid.size() <= 128))
        && (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 254));
    }

    function isValidBugReport(data) {
      return data.keys().hasAll(['id', 'authorId', 'reporterName', 'category', 'explanation', 'status'])
        && data.keys().hasOnly([
          'id', 'authorId', 'reporterName', 'reporterAccountNumber', 'reporterEmail',
          'category', 'explanation', 'photoFileName', 'status', 'adminReply', 'createdAt', 'updatedAt'
        ])
        && data.id is string && isValidId(data.id)
        && data.authorId is string && data.authorId.size() <= 128
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 2000
        && data.status is string && data.status in ['baru', 'diproses', 'selesai']
        && (!('reporterAccountNumber' in data) || (data.reporterAccountNumber is string && data.reporterAccountNumber.size() <= 32))
        && (!('reporterEmail' in data) || (data.reporterEmail is string && data.reporterEmail.size() <= 160))
        && (!('photoFileName' in data) || (data.photoFileName is string && data.photoFileName.size() <= 180))
        && (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 2000));
    }

    function isValidGlobalVisit(data) {
      return data.keys().hasAll(['id', 'sessionId', 'timestampMs', 'deviceId', 'accessType', 'accountRole'])
        && data.keys().hasOnly([
          'id', 'sessionId', 'timestampIso', 'timestampMs', 'dateKey', 'monthKey', 'hourOfDay',
          'deviceId', 'deviceSessionKey', 'accessType', 'accessTypeLabel', 'deviceBrandModel',
          'osLabel', 'browserLabel', 'publicIp', 'city', 'region', 'country', 'isp',
          'accountId', 'accountUid', 'accountName', 'accountEmail', 'accountNumber',
          'accountRole', 'isAdmin', 'triggerType', 'updatedAt', 'updatedAtMs', 'updatedAtServer'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128
        && data.timestampMs is number
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
        && data.accessType is string && data.accessType in ['web_browser', 'apk_webview']
        && data.accountRole is string && data.accountRole in ['admin', 'customer', 'guest']
        && (!('publicIp' in data) || (data.publicIp is string && data.publicIp.size() <= 80))
        && (!('city' in data) || (data.city is string && data.city.size() <= 120))
        && (!('region' in data) || (data.region is string && data.region.size() <= 120))
        && (!('country' in data) || (data.country is string && data.country.size() <= 120))
        && (!('isp' in data) || (data.isp is string && data.isp.size() <= 160))
        && (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 160))
        && (!('accountEmail' in data) || (data.accountEmail is string && data.accountEmail.size() <= 254))
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (!('triggerType' in data) || (data.triggerType is string && data.triggerType in ['app_open', 'account_login', 'reopen']));
    }

    function isValidAccountVisit(data) {
      return data.keys().hasAll(['accountKey', 'accountId', 'accountName', 'role', 'totalVisits', 'lastActiveMs'])
        && data.keys().hasOnly([
          'accountKey', 'accountId', 'accountUid', 'accountNumber', 'accountName', 'accountEmail',
          'role', 'roleLabel', 'isAdmin', 'totalVisits', 'firstVisitIso', 'lastActiveIso',
          'lastActiveMs', 'deviceIds', 'locations', 'recentVisits',
          'updatedAt', 'updatedAtMs', 'updatedAtServer'
        ])
        && data.accountKey is string && data.accountKey.size() >= 1 && data.accountKey.size() <= 254
        && data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128
        && data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 160
        && data.role is string && data.role in ['admin', 'customer']
        && data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 100000000
        && data.lastActiveMs is number
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (!('deviceIds' in data) || (data.deviceIds is list && data.deviceIds.size() <= 500))
        && (!('locations' in data) || (data.locations is list && data.locations.size() <= 500))
        && (!('recentVisits' in data) || (data.recentVisits is list && data.recentVisits.size() <= 500));
    }

    function isValidRealtimeDeviceSession(data) {
      return data.keys().hasAll(['sessionKey', 'deviceId', 'locationKey', 'totalVisits', 'lastSeenMs', 'isOnline', 'specs'])
        && data.keys().hasOnly([
          'sessionKey', 'deviceId', 'fingerprintHash', 'locationKey', 'locationLabel',
          'locationSource', 'gpsLat', 'gpsLng',
          'previousLocations', 'linkedSessionKeys', 'totalVisits', 'firstSeenIso', 'firstSeenMs',
          'lastSeenIso', 'lastSeenMs', 'isOnline',
          'currentAccountId', 'currentAccountNumber', 'currentAccountKey', 'currentAccountName',
          'currentAccountEmail', 'currentAccountRole', 'isAdminActive', 'accountsHistory',
          'reviewStatus', 'reviewNote', 'specs', 'updatedAt', 'updatedAtMs', 'updatedAtServer'
        ])
        && data.sessionKey is string && data.sessionKey.size() >= 1 && data.sessionKey.size() <= 200
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
        && data.locationKey is string && data.locationKey.size() >= 1 && data.locationKey.size() <= 160
        && data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 100000000
        && data.lastSeenMs is number
        && data.isOnline is bool
        && data.specs is map
        && (!('locationSource' in data) || (data.locationSource is string && data.locationSource in ['gps', 'geoip', 'timezone']))
        && (!('gpsLat' in data) || data.gpsLat == null || (data.gpsLat is number && data.gpsLat >= -90 && data.gpsLat <= 90))
        && (!('gpsLng' in data) || data.gpsLng == null || (data.gpsLng is number && data.gpsLng >= -180 && data.gpsLng <= 180))
        && (!('currentAccountRole' in data) || (data.currentAccountRole is string && data.currentAccountRole in ['admin', 'customer', 'guest']))
        && (!('reviewStatus' in data) || (data.reviewStatus is string && data.reviewStatus in ['normal', 'watched', 'safe']))
        && (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500))
        && (!('accountsHistory' in data) || (data.accountsHistory is list && data.accountsHistory.size() <= 200));
    }

    // ------------------------------------------------------------------------
    // ISOLASI TENANT MUTLAK BERBASIS UID: /users/{userId}/...
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isVerifiedAdmin());
      allow list: if isVerifiedAdmin();
      allow create: if isValidId(userId)
        && (isOwner(userId) || isVerifiedAdmin())
        && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (
          isVerifiedAdmin()
          || (
            isOwner(userId)
            && passesRateLimit()
            && (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid)
            && (!('status' in existing()) || incoming().status == existing().status)
          )
        );
      allow delete: if isValidId(userId) && isVerifiedAdmin();

      // 2.1 Personal Vault State (Atomic Concurrency + Rate Limiting)
      match /vault_state/{stateId} {
        allow get: if isValidId(userId) && isValidId(stateId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(stateId)
          && isOwner(userId)
          && isValidVaultState(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(stateId)
          && isOwner(userId)
          && isValidVaultState(incoming(), userId)
          && preservesImmutableCore(userId)
          && passesRateLimit()
          && incoming().syncVersion > existing().syncVersion
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'updatedAt', 'updatedAtServer', 'updatedAtMs', 'updatedAtIso',
            'syncVersion', 'lastDeviceId', 'payload'
          ]);
        allow delete: if isValidId(userId) && isValidId(stateId) && isOwner(userId);
      }

      // 2.1b Legacy Split Vault Docs (/users/{userId}/vault/{core|ledger|extras})
      match /vault/{vaultDocId} {
        allow get: if isValidId(userId) && isValidId(vaultDocId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(vaultDocId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidLegacyVaultSubDoc(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(vaultDocId)
          && isOwner(userId)
          && isValidLegacyVaultSubDoc(incoming(), userId)
          && incoming().ownerId == existing().ownerId;
        allow delete: if isValidId(userId) && isValidId(vaultDocId) && isOwner(userId);
      }

      // 2.2 Time-Machine Cloud Snapshots (Rolling Max 5 Versions)
      match /snapshots/{snapshotId} {
        allow get: if isValidId(userId) && isValidId(snapshotId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(snapshotId)
          && isOwner(userId)
          && isValidSnapshot(incoming(), userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(snapshotId) && isOwner(userId);
      }

      // 2.3 Immutable Security Audit Trail (Append-Only)
      match /security_logs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && (isOwner(userId) || isVerifiedAdmin());
        allow list: if (isOwner(userId) && resource.data.ownerUid == request.auth.uid) || isVerifiedAdmin();
        allow create: if isValidId(userId) && isValidId(logId)
          && isOwner(userId)
          && isValidSecurityLog(incoming(), userId);
        allow update: if false;
        allow delete: if false;
      }

      // 2.4 Active Device Sessions Registry
      match /devices/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(deviceId)
          && isOwner(userId)
          && isValidDeviceSession(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(deviceId)
          && isOwner(userId)
          && isValidDeviceSession(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().deviceId == existing().deviceId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'deviceLabel', 'platform', 'userAgent', 'authMethod',
            'lastActiveIso', 'lastActiveMs', 'revoked', 'revokedAtIso', 'updatedAtServer'
          ]);
        allow delete: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
      }
    }

    // ------------------------------------------------------------------------
    // ADMIN REGISTRY
    // ------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isVerifiedAdmin());
      allow list, create, update, delete: if false;
    }

    // ------------------------------------------------------------------------
    // BUG REPORTS
    // ------------------------------------------------------------------------
    match /bug_reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (isVerifiedAdmin() || existing().authorId == request.auth.uid);
      allow list: if isVerifiedAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isValidId(reportId)
        && isSignedIn()
        && isValidBugReport(incoming())
        && incoming().authorId == request.auth.uid;
      allow update: if isValidId(reportId)
        && isSignedIn()
        && isValidBugReport(incoming())
        && (
          isVerifiedAdmin()
          || (
            existing().authorId == request.auth.uid
            && existing().status != 'selesai'
            && incoming().authorId == existing().authorId
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['explanation', 'category', 'photoFileName', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reportId) && isVerifiedAdmin();
    }

    // ------------------------------------------------------------------------
    // PROBE KONEKSI & BANK NUSANTARA SHARED OPERATIONAL STATE
    // ------------------------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /users_by_email/{emailKey} {
      allow get: if isValidId(emailKey)
        && isSignedIn()
        && (
          isVerifiedAdmin()
          || (resource != null && resource.data.uid == request.auth.uid)
          || (request.auth.token.email_verified == true && resource != null && resource.data.email == request.auth.token.email)
        );
      allow list: if isVerifiedAdmin();
      allow create, update: if isValidId(emailKey)
        && isSignedIn()
        && (isVerifiedAdmin() || incoming().uid == request.auth.uid);
      allow delete: if isValidId(emailKey) && isVerifiedAdmin();
    }

    // Dedicated Admin Global Signature & Stamp Config (Strict Verified Admin Write)
    match /bank_state_v1/letter_seal_config {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isVerifiedAdmin() && isValidLetterSealRegistry(incoming());
      allow update: if isVerifiedAdmin()
        && isValidLetterSealRegistry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'config', 'updatedAtMs', 'updatedAt', 'writerSessionId', 'updatedByUid', 'updatedByEmail'
        ]);
      allow delete: if isVerifiedAdmin();
    }

    // Dedicated Gift & Official Letter Registry (Verified Admin full control; customers interaction-only)
    match /bank_state_v1/gift_events_registry {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isVerifiedAdmin() && isValidGiftEventsRegistry(incoming());
      allow update: if isValidGiftEventsRegistry(incoming())
        && (
          isVerifiedAdmin()
          || (
            isSignedIn()
            && incoming().giftEventsInitialized == existing().giftEventsInitialized
            && incoming().giftEventsUpdatedAtMs == existing().giftEventsUpdatedAtMs
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'giftEvents', 'updatedAtMs', 'updatedAt', 'writerSessionId'
            ])
          )
        );
      allow delete: if isVerifiedAdmin();
    }

    match /bank_state_v1/{docId} {
      allow get: if isValidId(docId)
        && docId != 'letter_seal_config'
        && docId != 'gift_events_registry'
        && isSignedIn();
      allow list: if false;
      allow create, update: if isValidId(docId)
        && docId != 'letter_seal_config'
        && docId != 'gift_events_registry'
        && isSignedIn()
        && incoming().updatedAtMs is number;
      allow delete: if isValidId(docId) && isVerifiedAdmin();
    }

    // ------------------------------------------------------------------------
    // REAL-TIME VISITOR ANALYTICS COLLECTIONS (ADMIN-ONLY READ FOR PII/IP)
    // ------------------------------------------------------------------------
    match /global_visits/{visitId} {
      allow get, list: if isVerifiedAdmin();
      allow create: if isValidId(visitId)
        && isSignedIn()
        && isValidGlobalVisit(incoming());
      allow update: if false;
      allow delete: if isValidId(visitId) && isVerifiedAdmin();
    }

    match /account_visits/{accountKey} {
      allow get, list: if isVerifiedAdmin();
      allow create, update: if isValidId(accountKey)
        && isSignedIn()
        && isValidAccountVisit(incoming());
      allow delete: if isValidId(accountKey) && isVerifiedAdmin();
    }

    match /device_sessions/{sessionKey} {
      allow get, list: if isVerifiedAdmin();
      allow create, update: if isValidId(sessionKey)
        && isSignedIn()
        && isValidRealtimeDeviceSession(incoming());
      allow delete: if isValidId(sessionKey) && isVerifiedAdmin();
    }
  }
}
