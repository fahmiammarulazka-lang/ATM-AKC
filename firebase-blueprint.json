{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Bank Nusantara customer and admin accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "balance": { "type": "number" },
        "pin": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "tier": { "type": "string" },
        "hasAccessedAdminPanel": { "type": "boolean" }
      },
      "required": ["id", "accountNumber", "fullName", "balance"]
    },
    "GiftEvent": {
      "title": "GiftEvent",
      "description": "Admin gift and letter event packages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "senderName": { "type": "string" },
        "letterMessage": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Customer accounts collection"
    },
    "/giftEvents/{eventId}": {
      "schema": { "$ref": "#/entities/GiftEvent" },
      "description": "Admin gift events collection"
    }
  }
}
