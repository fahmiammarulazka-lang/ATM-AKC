{
  "entities": {
    "CloudUser": {
      "title": "CloudUser",
      "description": "Authenticated Google or Anonymous Vault user profile, real-time ban enforcement status, and sync metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "banned"] },
        "banReason": { "type": "string", "maxLength": 1000 },
        "lastAccountId": { "type": "string", "maxLength": 128 },
        "hasCompletedOnboarding": { "type": "boolean" },
        "isAnonymousVault": { "type": "boolean" },
        "authMode": { "type": "string", "enum": ["google", "guest", "email_direct"] },
        "emailKey": { "type": "string", "maxLength": 128 },
        "lastDeviceId": { "type": "string", "maxLength": 128 },
        "syncVersion": { "type": "integer" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["uid", "ownerUid", "status"]
    },
    "VaultState": {
      "title": "VaultState",
      "description": "UID-isolated personal banking vault synchronized with optimistic concurrency control",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "createdAtIso": { "type": "string", "maxLength": 64 },
        "updatedAtIso": { "type": "string", "maxLength": 64 },
        "syncVersion": { "type": "integer" },
        "lastDeviceId": { "type": "string", "maxLength": 128 },
        "payload": { "type": "object" }
      },
      "required": ["ownerUid", "syncVersion", "lastDeviceId", "payload"]
    },
    "TimeMachineSnapshot": {
      "title": "TimeMachineSnapshot",
      "description": "Rolling cloud checkpoint (max 5 newest) with SHA-256 integrity hash",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 160 },
        "triggerReason": {
          "type": "string",
          "enum": ["manual", "pre_restore", "pre_import", "pre_reset", "pre_merge"]
        },
        "createdAtMs": { "type": "number" },
        "createdAtIso": { "type": "string", "maxLength": 64 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "accountCount": { "type": "integer" },
        "transactionCount": { "type": "integer" },
        "pocketCount": { "type": "integer" },
        "totalBalance": { "type": "number" },
        "totalGoldGrams": { "type": "number" },
        "payload": { "type": "object" }
      },
      "required": ["id", "ownerUid", "label", "triggerReason", "sha256", "payload"]
    },
    "SecurityAuditLog": {
      "title": "SecurityAuditLog",
      "description": "Immutable append-only security audit trail per user UID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["success", "warning", "blocked"] },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceLabel": { "type": "string", "maxLength": 120 },
        "platform": { "type": "string", "maxLength": 80 },
        "userAgent": { "type": "string", "maxLength": 320 },
        "createdAtMs": { "type": "number" },
        "createdAtIso": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "eventType", "summary", "status", "deviceId", "createdAtMs"]
    },
    "DeviceSession": {
      "title": "DeviceSession",
      "description": "Registered browser device sessions per user UID with revocation support",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceLabel": { "type": "string", "maxLength": 120 },
        "platform": { "type": "string", "maxLength": 80 },
        "userAgent": { "type": "string", "maxLength": 320 },
        "authMethod": { "type": "string", "enum": ["google", "anonymous"] },
        "firstSeenIso": { "type": "string", "maxLength": 64 },
        "lastActiveIso": { "type": "string", "maxLength": 64 },
        "lastActiveMs": { "type": "number" },
        "revoked": { "type": "boolean" },
        "revokedAtIso": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "deviceId", "authMethod", "revoked"]
    },
    "MasterCloudState": {
      "title": "MasterCloudState",
      "description": "Shared Bank Nusantara real-time state document for inter-account transfers and admin operations",
      "type": "object",
      "properties": {
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "writerSessionId": { "type": "string", "maxLength": 128 },
        "giftEventsInitialized": { "type": "boolean" }
      },
      "required": ["updatedAtMs"]
    },
    "GiftEventsRegistry": {
      "title": "GiftEventsRegistry",
      "description": "Dedicated persistent registry of Admin-created Gift & Official Letter packages and permanently deleted package IDs",
      "type": "object",
      "properties": {
        "giftEventsInitialized": { "type": "boolean" },
        "giftEventsUpdatedAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "writerSessionId": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByEmail": { "type": "string", "maxLength": 254 }
      },
      "required": ["giftEventsInitialized", "giftEventsUpdatedAtMs", "updatedAtMs"]
    },
    "LetterSealGlobalConfig": {
      "title": "LetterSealGlobalConfig",
      "description": "Dedicated persistent Admin global signature drawing/template and official stamp configuration",
      "type": "object",
      "properties": {
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "writerSessionId": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByEmail": { "type": "string", "maxLength": 254 }
      },
      "required": ["updatedAtMs"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "Customer bug report submitted with author UID and lifecycle status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 120 },
        "reporterAccountNumber": { "type": "string", "maxLength": 32 },
        "reporterEmail": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "explanation": { "type": "string", "maxLength": 2000 },
        "photoFileName": { "type": "string", "maxLength": 180 },
        "status": { "type": "string", "enum": ["baru", "diproses", "selesai"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "reporterName", "category", "explanation", "status"]
    },
    "GlobalVisitLog": {
      "title": "GlobalVisitLog",
      "description": "Every individual Web/APK visitor entry event with 10s debounce metadata, environment, and server-resolved geo metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "timestampIso": { "type": "string", "maxLength": 64 },
        "timestampMs": { "type": "number" },
        "dateKey": { "type": "string", "maxLength": 16 },
        "monthKey": { "type": "string", "maxLength": 16 },
        "hourOfDay": { "type": "integer" },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceSessionKey": { "type": "string", "maxLength": 200 },
        "accessType": { "type": "string", "enum": ["web_browser", "apk_webview"] },
        "accessTypeLabel": { "type": "string", "maxLength": 120 },
        "deviceBrandModel": { "type": "string", "maxLength": 160 },
        "osLabel": { "type": "string", "maxLength": 100 },
        "browserLabel": { "type": "string", "maxLength": 100 },
        "publicIp": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 120 },
        "region": { "type": "string", "maxLength": 120 },
        "country": { "type": "string", "maxLength": 120 },
        "isp": { "type": "string", "maxLength": 160 },
        "accountName": { "type": "string", "maxLength": 160 },
        "accountEmail": { "type": "string", "maxLength": 254 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "accountRole": { "type": "string", "enum": ["admin", "customer", "guest"] },
        "isAdmin": { "type": "boolean" },
        "triggerType": { "type": "string", "enum": ["app_open", "account_login", "reopen"] }
      },
      "required": ["id", "sessionId", "timestampMs", "deviceId", "accessType", "accountRole"]
    },
    "AccountVisitSummary": {
      "title": "AccountVisitSummary",
      "description": "Per-account cumulative visit counter, device list, locations, and chronological login history",
      "type": "object",
      "properties": {
        "accountKey": { "type": "string", "maxLength": 254 },
        "accountId": { "type": "string", "maxLength": 128 },
        "accountUid": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "accountName": { "type": "string", "maxLength": 160 },
        "accountEmail": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "roleLabel": { "type": "string", "maxLength": 120 },
        "isAdmin": { "type": "boolean" },
        "totalVisits": { "type": "integer" },
        "lastActiveMs": { "type": "number" },
        "deviceIds": { "type": "array", "items": { "type": "string" } },
        "locations": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["accountKey", "accountId", "accountName", "role", "totalVisits", "lastActiveMs"]
    },
    "RealtimeDeviceSession": {
      "title": "RealtimeDeviceSession",
      "description": "Real-time physical device + location fingerprint tracker with online heartbeat, multi-account history, and hardware specifications",
      "type": "object",
      "properties": {
        "sessionKey": { "type": "string", "maxLength": 200 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "fingerprintHash": { "type": "string", "maxLength": 128 },
        "locationKey": { "type": "string", "maxLength": 160 },
        "locationLabel": { "type": "string", "maxLength": 200 },
        "locationSource": { "type": "string", "enum": ["gps", "geoip", "timezone"] },
        "gpsLat": { "type": "number" },
        "gpsLng": { "type": "number" },
        "totalVisits": { "type": "integer" },
        "firstSeenMs": { "type": "number" },
        "lastSeenMs": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "currentAccountId": { "type": "string", "maxLength": 128 },
        "currentAccountNumber": { "type": "string", "maxLength": 64 },
        "currentAccountRole": { "type": "string", "enum": ["admin", "customer", "guest"] },
        "reviewStatus": { "type": "string", "enum": ["normal", "watched", "safe"] },
        "specs": { "type": "object" }
      },
      "required": ["sessionKey", "deviceId", "locationKey", "totalVisits", "lastSeenMs", "isOnline", "specs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/CloudUser" },
      "description": "UID-isolated user identity profile and protection status"
    },
    "/users/{userId}/vault_state/{stateId}": {
      "schema": { "$ref": "#/entities/VaultState" },
      "description": "UID-isolated personal banking vault with atomic concurrency metadata"
    },
    "/users/{userId}/snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/TimeMachineSnapshot" },
      "description": "UID-isolated Time-Machine rolling cloud snapshots (max 5 versions)"
    },
    "/users/{userId}/security_logs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityAuditLog" },
      "description": "UID-isolated immutable append-only security audit trail"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceSession" },
      "description": "UID-isolated browser device registry and revocation control"
    },
    "/users_by_email/{emailKey}": {
      "schema": { "$ref": "#/entities/CloudUser" },
      "description": "Email-indexed user profile mirror for cross-device account lookup"
    },
    "/bank_state_v1/{docId}": {
      "schema": { "$ref": "#/entities/MasterCloudState" },
      "description": "Shared Bank Nusantara operational state for inter-account transfers and OA accounts"
    },
    "/bank_state_v1/gift_events_registry": {
      "schema": { "$ref": "#/entities/GiftEventsRegistry" },
      "description": "Dedicated persistent registry for Admin Gift & Official Letter packages"
    },
    "/bank_state_v1/letter_seal_config": {
      "schema": { "$ref": "#/entities/LetterSealGlobalConfig" },
      "description": "Dedicated persistent Admin global signature and official stamp config"
    },
    "/bug_reports/{reportId}": {
      "schema": { "$ref": "#/entities/BugReport" },
      "description": "Customer bug reports with UID ownership and Admin moderation"
    },
    "/global_visits/{visitId}": {
      "schema": { "$ref": "#/entities/GlobalVisitLog" },
      "description": "Real-time global Web & APK visitor hits log (Admin-only read)"
    },
    "/account_visits/{accountKey}": {
      "schema": { "$ref": "#/entities/AccountVisitSummary" },
      "description": "Real-time per-account visit totals and chronological login history (Admin-only read)"
    },
    "/device_sessions/{sessionKey}": {
      "schema": { "$ref": "#/entities/RealtimeDeviceSession" },
      "description": "Real-time device fingerprint + location session tracker with full hardware specs (Admin-only read)"
    }
  }
}
